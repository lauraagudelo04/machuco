rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Nombre y celular con tipo y largo acotados (mismos limites que la app).
    function hasValidContactFields(data) {
      return data.fullName is string
        && data.fullName.size() >= 3 && data.fullName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 4 && data.phoneNumber.size() <= 20;
    }

    // Perfiles de usuario. El rol y el estado de la cuenta viven aqui y solo
    // se pueden asignar en la creacion (valores iniciales) o por un admin.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Registro publico: nunca admin; cliente activo, propietario pendiente.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['fullName', 'email', 'phoneNumber', 'role', 'accountStatus', 'createdAt'])
        && hasValidContactFields(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['client', 'owner']
        && (
          (request.resource.data.role == 'client'
            && request.resource.data.accountStatus == 'active')
          ||
          (request.resource.data.role == 'owner'
            && request.resource.data.accountStatus == 'pending_approval')
        )
        && request.resource.data.createdAt == request.time;

      // Un admin solo cambia el estado de la cuenta (aprobar, rechazar,
      // deshabilitar); nunca el rol, ni siquiera el suyo. Si la aprobacion de
      // propietarios necesita mas campos (p. ej. motivo de rechazo), se
      // agregan aqui de forma explicita.
      // El propio usuario solo puede cambiar su nombre y su celular.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['accountStatus'])
          && request.resource.data.accountStatus
              in ['active', 'pending_approval', 'rejected', 'disabled'])
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'phoneNumber'])
          && hasValidContactFields(request.resource.data));

      allow delete: if false;

      match /subscriptions/{subscriptionId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'localId', 'userEmail', 'planId', 'planName', 'motelName',
            'amount', 'billingPeriod', 'nextBillingDate', 'status',
            'features', 'updatedAt']);
        allow delete: if false;

        match /payments/{paymentId} {
          allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
          allow create, update: if isSignedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
              'localId', 'subscriptionLocalId', 'date', 'amount',
              'paymentMethod', 'reference', 'status', 'updatedAt']);
          allow delete: if false;
        }
      }
    }

    // Reseñas de cliente (colección `reviews`, ver FirestoreCollections).
    //
    // Las reseñas ocultas siguen siendo legibles para cualquier usuario
    // autenticado: "oculta" es una regla de presentación (no aparece ni
    // cuenta en el promedio), no un control de acceso. Filtrar por estado
    // aquí rompería la lista completa del administrador, porque una consulta
    // no se puede filtrar documento por documento: la consulta fallaría
    // entera si un solo documento no cumple la regla.
    //
    // El autor no se puede comprobar contra el motel: los moteles y su
    // propietario viven en Supabase, no en Firestore, así que `isAdmin()` es
    // el único rol verificable aquí. La relación reseña-propietario se valida
    // en la capa de Supabase.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();

      // Solo el propio autor crea, siempre como visible y con los campos
      // acotados: nace visible y sin respuesta, y se modera después.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'visible'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 1000
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1
        && request.resource.data.body.size() <= 1000
        && request.resource.data.motelId is string
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'body', 'rating', 'date',
          'motelId', 'roomId', 'type', 'status', 'reportReason',
          'adminReply', 'ownerReply']);

      // El administrador modera y responde todo; el autor solo puede
      // escribir la respuesta del propietario (y nunca cambiar autoría,
      // calificación ni estado). Un propietario no se puede distinguir de
      // otro usuario autenticado sin los moteles de Supabase.
      allow update: if isAdmin()
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerReply'])
          && request.resource.data.ownerReply is string
          && request.resource.data.ownerReply.size() <= 1000);

      allow delete: if isAdmin();
    }

    // Denegado por defecto. Cada rama debe agregar su coleccion de forma
    // explicita ARRIBA de esta regla, con su propia autorizacion por rol.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
