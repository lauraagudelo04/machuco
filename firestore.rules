rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isActiveOwner() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    function isActiveClient() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'client'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    // Pago que un cliente registra al finalizar su reserva: en el local queda
    // pendiente y sin metodo (lo confirma el propietario); con tarjeta nace
    // pagado, con su metodo y fecha de pago.
    function isClientPaymentCreate(data) {
      return isActiveClient()
        && data.clientId == request.auth.uid
        && data.ownerId != request.auth.uid
        && (
          (data.status == 'pending'
            && !('method' in data)
            && !('paymentMethodId' in data)
            && !('paidAt' in data)
            && !('receiptNumber' in data))
          ||
          (data.status == 'paid'
            && 'paymentMethodId' in data
            && 'paidAt' in data)
        );
    }

    function hasValidPaymentFields(data) {
      return data.keys().hasAll([
          'ownerId', 'bookingId', 'bookingReference', 'clientId', 'client',
          'motelId', 'motel', 'roomId', 'room', 'reservationDate', 'amount',
          'status', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'bookingId', 'bookingReference', 'clientId', 'client',
          'motelId', 'motel', 'roomId', 'room', 'reservationDate', 'amount',
          'status', 'method', 'paymentMethodId', 'paidAt', 'receiptNumber',
          'paymentMethodName', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() > 0
        && data.bookingId is string && data.bookingId.size() > 0
        && data.bookingReference is string && data.bookingReference.size() > 0
        && data.clientId is string && data.clientId.size() > 0
        && data.client is string && data.client.size() > 0
        && data.motelId is string && data.motelId.size() > 0
        && data.motel is string && data.motel.size() > 0
        && data.roomId is string && data.roomId.size() > 0
        && data.room is string && data.room.size() > 0
        && data.reservationDate is timestamp
        && data.amount is int && data.amount > 0
        && data.status in ['pending', 'paid', 'refunded', 'cancelled']
        && (!('method' in data) || data.method in ['online', 'cash'])
        && (!('paymentMethodId' in data)
          || (data.paymentMethodId is int && data.paymentMethodId > 0))
        && (!('paymentMethodName' in data)
          || (data.paymentMethodName is string
            && data.paymentMethodName.size() > 0
            && data.paymentMethodName.size() <= 100))
        && (!('paymentMethodId' in data) || 'paymentMethodName' in data)
        && (!('paidAt' in data) || data.paidAt is timestamp)
        && (!('receiptNumber' in data)
          || (data.receiptNumber is string && data.receiptNumber.size() > 0))
        && data.updatedAt == request.time;
    }

    function isValidPaymentTransition(previous, next) {
      return previous == next
        || (previous == 'pending' && next in ['paid', 'cancelled'])
        || (previous == 'paid' && next == 'refunded');
    }

    function isLegacyDemoPaymentId(paymentId) {
      return paymentId in [
        'pay-001', 'pay-002', 'pay-003',
        'owner-pay-001', 'owner-pay-002', 'owner-pay-003'
      ];
    }

    // Reservas: campos y tipos permitidos (mismo esquema que
    // ReservationFirestoreDocument en la app).
    function hasValidReservationFields(data) {
      return data.keys().hasAll([
          'ownerId', 'guestId', 'guestName', 'requestId', 'motelId',
          'motelName', 'roomId', 'roomName', 'roomNumber', 'checkIn',
          'checkOut', 'stayMode', 'guestCount', 'services', 'products',
          'roomTotal', 'total', 'status', 'createdAt', 'invoiceAccessStatus',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'guestId', 'guestName', 'requestId', 'motelId',
          'motelName', 'roomId', 'roomName', 'roomNumber', 'checkIn',
          'checkOut', 'stayMode', 'guestCount', 'services', 'products',
          'roomTotal', 'total', 'status', 'createdAt', 'categoryId',
          'cancellationReason', 'invoiceAccessStatus', 'paymentMethod',
          'updatedAt'
        ])
        && data.ownerId is string && data.ownerId.size() > 0
        && data.guestId is string && data.guestId.size() > 0
        && data.guestName is string && data.guestName.size() <= 100
        && data.requestId is string && data.requestId.size() > 0
        && data.motelId is string && data.motelId.size() > 0
        && data.motelName is string && data.motelName.size() > 0
        && data.roomId is string && data.roomId.size() > 0
        && data.roomName is string && data.roomName.size() > 0
        && data.roomNumber is string && data.roomNumber.size() > 0
        && data.checkIn is timestamp
        && data.checkOut is timestamp
        && data.checkOut > data.checkIn
        && data.stayMode in ['dateTimeRange', 'dateWithHourBlock']
        && data.guestCount is int && data.guestCount > 0
        && data.services is list && data.services.size() <= 50
        && data.products is list && data.products.size() <= 50
        && data.roomTotal is int && data.roomTotal >= 0
        && data.total is int && data.total >= data.roomTotal
        && data.status in
          ['pending', 'active', 'upcoming', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && (!('categoryId' in data) || data.categoryId is int)
        && (!('cancellationReason' in data)
          || (data.cancellationReason is string
            && data.cancellationReason.size() > 0
            && data.cancellationReason.size() <= 500))
        && data.invoiceAccessStatus in
          ['notApplicable', 'pending', 'available']
        && (!('paymentMethod' in data)
          || (data.paymentMethod is string
            && data.paymentMethod.size() > 0
            && data.paymentMethod.size() <= 100))
        && data.updatedAt == request.time;
    }

    // Mismas transiciones que BookingService: pago, cancelacion y las que
    // ocurren por el paso del tiempo (pueden encadenarse en una escritura).
    function isValidReservationTransition(previous, next) {
      return previous == next
        || (previous == 'pending'
          && next in ['upcoming', 'active', 'completed', 'cancelled'])
        || (previous == 'upcoming'
          && next in ['active', 'completed', 'cancelled'])
        || (previous == 'active' && next == 'completed');
    }

    // El cliente, el propietario del motel o el admin pueden avanzar el
    // estado; nunca cambiar quien es el cliente, el motel, las fechas o el
    // valor de la reserva.
    function isReservationParticipant(data) {
      return isAdmin()
        || (isActiveClient() && data.guestId == request.auth.uid)
        || (isActiveOwner() && data.ownerId == request.auth.uid);
    }

    // Nombre y celular con tipo y largo acotados (mismos limites que la app).
    function hasValidContactFields(data) {
      return data.fullName is string
        && data.fullName.size() >= 3 && data.fullName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.size() >= 4 && data.phoneNumber.size() <= 20;
    }

    // Perfiles de usuario. El rol y el estado de la cuenta viven aqui y solo
    // se pueden asignar en la creacion (valores iniciales) o por un admin.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Registro publico: nunca admin; cliente activo, propietario pendiente.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['fullName', 'email', 'phoneNumber', 'role', 'accountStatus', 'createdAt'])
        && hasValidContactFields(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['client', 'owner']
        && (
          (request.resource.data.role == 'client'
            && request.resource.data.accountStatus == 'active')
          ||
          (request.resource.data.role == 'owner'
            && request.resource.data.accountStatus == 'pending_approval')
        )
        && request.resource.data.createdAt == request.time;

      // Un admin solo cambia el estado de la cuenta (aprobar, rechazar,
      // deshabilitar); nunca el rol, ni siquiera el suyo. Si la aprobacion de
      // propietarios necesita mas campos (p. ej. motivo de rechazo), se
      // agregan aqui de forma explicita.
      // El propio usuario solo puede cambiar su nombre y su celular.
      allow update: if (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['accountStatus'])
          && request.resource.data.accountStatus
              in ['active', 'pending_approval', 'rejected', 'disabled'])
        || (isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'phoneNumber'])
          && hasValidContactFields(request.resource.data));

      allow delete: if false;

      match /subscriptions/{subscriptionId} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly([
            'localId', 'userEmail', 'planId', 'planName', 'motelName',
            'amount', 'billingPeriod', 'nextBillingDate', 'status',
            'features', 'updatedAt']);
        allow delete: if false;

        match /payments/{paymentId} {
          allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
          allow create, update: if isSignedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly([
              'localId', 'subscriptionLocalId', 'date', 'amount',
              'paymentMethod', 'reference', 'status', 'updatedAt']);
          allow delete: if false;
        }
      }
    }

    // Pagos sincronizados con Cloud Firestore. El propietario los lee y los
    // confirma; el cliente solo puede crear los suyos (ver
    // isClientPaymentCreate) y no tiene historial de Payment en la app final.
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isActiveOwner() && resource.data.ownerId == request.auth.uid);

      allow create: if !isLegacyDemoPaymentId(paymentId)
        && hasValidPaymentFields(request.resource.data)
        && (
          (isActiveOwner()
            && request.resource.data.ownerId == request.auth.uid)
          || isClientPaymentCreate(request.resource.data)
        );

      allow update: if isActiveOwner()
        && !isLegacyDemoPaymentId(paymentId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'method', 'paymentMethodId', 'paidAt', 'receiptNumber',
          'paymentMethodName', 'updatedAt'
        ])
        && isValidPaymentTransition(
          resource.data.status,
          request.resource.data.status
        )
        && hasValidPaymentFields(request.resource.data);

      allow delete: if false;
    }

    // Reservas compartidas por cliente, propietario y administrador
    // (ReservationCloudRepository). El cliente ve las suyas, el propietario
    // las de sus moteles (ownerId) y el admin todas. Solo el cliente las crea,
    // a su nombre. El estado inicial puede no ser `pending` si la reserva se
    // pago sin conexion antes de sincronizarse.
    match /reservations/{reservationId} {
      allow read: if isReservationParticipant(resource.data);

      allow create: if isActiveClient()
        && request.resource.data.guestId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && hasValidReservationFields(request.resource.data);

      allow update: if isReservationParticipant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'cancellationReason', 'invoiceAccessStatus',
          'paymentMethod', 'updatedAt'
        ])
        && isValidReservationTransition(
          resource.data.status,
          request.resource.data.status
        )
        && hasValidReservationFields(request.resource.data);

      allow delete: if false;
    }

    // Denegado por defecto. Cada rama debe agregar su coleccion de forma
    // explicita ARRIBA de esta regla, con su propia autorizacion por rol.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
